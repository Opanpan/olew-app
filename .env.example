DOMAIN=olew.alriansyah.my.id
EMAIL=your@email.com
NEXT_PUBLIC_API_BASE_URL=https://api-olew.fajaramaulana.my.id
NEXT_PUBLIC_SITE_URL=https://olew.alriansyah.my.id

# ── Sentry (all optional: without a DSN the SDK stays off) ──────────────────
# Public by design; inlined at build time, so it's a Docker build arg too.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Source-map upload at build time. Without the token the upload is skipped.
SENTRY_ORG=
SENTRY_PROJECT=
# Secret (Org Auth Token, scope project:releases). Never commit a real value;
# Docker receives it as a BuildKit secret, so it never lands in an image layer.
SENTRY_AUTH_TOKEN=
